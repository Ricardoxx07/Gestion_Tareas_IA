# PostgreSQL local. Sustituye los valores de ejemplo antes de usarlo fuera de desarrollo.
POSTGRES_USER=gestor_app
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=gestor_tareas

DATABASE_URL=postgresql+psycopg://gestor_app:cambia_esta_contrasena@localhost:5432/gestor_tareas
DATABASE_URL_DOCKER=postgresql+psycopg://gestor_app:cambia_esta_contrasena@db:5432/gestor_tareas
TEST_DATABASE_URL=postgresql+psycopg://gestor_app:cambia_esta_contrasena@localhost:5432/gestor_tareas_test

# Autenticación. Genera una clave única y no la publiques.
JWT_SECRET_KEY=reemplaza_esta_clave_por_una_larga_y_aleatoria
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Usa "falso" para ejecutar pruebas o desarrollar sin Ollama.
IA_PROVIDER=falso
OLLAMA_MODEL=llama3.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_TOKENS=800

# Orígenes de frontend permitidos, separados por comas. No usar * con JWT.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
